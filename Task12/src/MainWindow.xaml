<Window x:Class="Task12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task12"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть файл" Command="{Binding OpenCommand}" />
                <MenuItem Header="Сохранить текущее в файл" Command="{Binding SaveCommand}" />
            </MenuItem>
        </Menu>

        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredTasks}" SelectedItem="{Binding SelectedTask}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}" Content="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="5">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding AddCommand}" Content="Добавить задачу" />
                <Button Command="{Binding RemoveCommand}" Content="Удалить задачу" />
                <ComboBox SelectedValue="{Binding Filter}" Width="150" DisplayMemberPath="Content" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Все" Tag="Все" />
                    <ComboBoxItem Content="Выполненные" Tag="Выполненные" />
                    <ComboBoxItem Content="Не выполненные" Tag="Не выполненные" />
                </ComboBox>
            </StackPanel>

            <Grid Margin="0,5,0,0">
                <TextBox Text="{Binding SelectedTask.Title, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0" />
                <TextBlock Text="Переименовать задачу" 
                           Foreground="Gray" 
                           VerticalAlignment="Center" 
                           Margin="5,0,0,0" 
                           Visibility="{Binding SelectedTask.Title, Converter={StaticResource StringToVisibilityConverter}}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
