<Window x:Class="Task10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task10"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
            <local:ImageIndicatorControl x:Name="ImageIndicator" Width="200" Height="200"/>
            <Button x:Name="NextImageButton" Content="Next Image" Click="NextImageButton_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="IntervalTextBox" Width="100" Text="1000" Margin="0,0,10,0"/>
            <Button x:Name="ApplyButton" Content="Apply" Click="ApplyButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="StartStopButton" Content="Start/Stop" Click="StartStopButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
